{
  "version": "loki.company-esocial/1",
  "proposal_schema": {
    "additionalProperties": false,
    "properties": {
      "mode": {
        "enum": [
          "homologacao",
          "operacao"
        ],
        "title": "Mode",
        "type": "string"
      },
      "event_types": {
        "default": [],
        "items": {
          "enum": [
            "S-1000",
            "S-1005",
            "S-1010",
            "S-1020",
            "S-2200",
            "S-2205",
            "S-2206",
            "S-2230",
            "S-2300",
            "S-2306",
            "S-1200",
            "S-1210",
            "S-2299",
            "S-2399",
            "S-1298",
            "S-1299",
            "S-3000"
          ],
          "type": "string"
        },
        "maxItems": 50,
        "title": "Event Types",
        "type": "array"
      },
      "cutover_on": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cutover On"
      }
    },
    "required": [
      "mode"
    ],
    "title": "ModeProposal",
    "type": "object"
  },
  "decision_schema": {
    "additionalProperties": false,
    "properties": {
      "expected_revision": {
        "minimum": 0,
        "title": "Expected Revision",
        "type": "integer"
      },
      "preview_hash": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Preview Hash",
        "type": "string"
      },
      "reference": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Reference",
        "type": "string"
      },
      "human_message": {
        "maxLength": 20000,
        "minLength": 1,
        "title": "Human Message",
        "type": "string"
      }
    },
    "required": [
      "expected_revision",
      "preview_hash",
      "reference",
      "human_message"
    ],
    "title": "ModeDecision",
    "type": "object"
  },
  "company_parameters_schema": {
    "$defs": {
      "CompanyConfigSource": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "declaration",
            "enum": [
              "declaration",
              "external_reference",
              "rule",
              "inference",
              "context"
            ],
            "title": "Kind",
            "type": "string"
          },
          "reference": {
            "default": "current_request",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reference",
            "type": "string"
          },
          "locator": {
            "anyOf": [
              {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Locator"
          },
          "content_hash": {
            "anyOf": [
              {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content Hash"
          },
          "foundation": {
            "anyOf": [
              {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Foundation"
          }
        },
        "title": "CompanyConfigSource",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
        "title": "Id",
        "type": "string"
      },
      "establishment_cnpj": {
        "title": "Establishment Cnpj",
        "type": "string"
      },
      "valid_from": {
        "format": "date",
        "title": "Valid From",
        "type": "string"
      },
      "valid_until": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Valid Until"
      },
      "cnae_preponderante": {
        "anyOf": [
          {
            "pattern": "^[0-9]{7}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cnae Preponderante"
      },
      "rat_bps": {
        "anyOf": [
          {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rat Bps"
      },
      "fap_10000": {
        "anyOf": [
          {
            "maximum": 20000,
            "minimum": 5000,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fap 10000"
      },
      "classificacao_tributaria": {
        "anyOf": [
          {
            "pattern": "^[0-9]{2}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Classificacao Tributaria"
      },
      "fpas": {
        "anyOf": [
          {
            "pattern": "^[0-9]{3}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fpas"
      },
      "codigo_terceiros": {
        "anyOf": [
          {
            "pattern": "^[0-9]{4}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Codigo Terceiros"
      },
      "basis": {
        "default": "informado",
        "enum": [
          "informado",
          "inferido",
          "confirmado"
        ],
        "title": "Basis",
        "type": "string"
      },
      "field_sources": {
        "additionalProperties": {
          "$ref": "#/$defs/CompanyConfigSource"
        },
        "maxProperties": 20,
        "title": "Field Sources",
        "type": "object"
      }
    },
    "required": [
      "id",
      "establishment_cnpj",
      "valid_from"
    ],
    "title": "CompanyParameters",
    "type": "object"
  },
  "company_parameter_write_tools": [
    "validate_client_config",
    "apply_client_config"
  ],
  "mode_destinations": {
    "homologacao": 2,
    "operacao": 1
  },
  "production_activation_supported": false,
  "history_import_creates_outbound_events": false,
  "existing_queue_retargeted_on_mode_change": false,
  "input_authority": "human_intent_declared_by_harness",
  "operations": [
    "get_company_esocial_state",
    "preview_company_esocial_mode",
    "apply_company_esocial_mode",
    "get_company_parameter_state",
    "get_company_esocial_candidate_contract",
    "prepare_company_esocial_candidate",
    "get_company_esocial_candidate",
    "cancel_company_esocial_candidate"
  ],
  "candidate_preparation": {
    "schema_version": "loki.company-esocial-candidate/1",
    "proposal_schema": {
      "$defs": {
        "CompanyParameterConfigPin": {
          "additionalProperties": false,
          "properties": {
            "version": {
              "minimum": 1,
              "title": "Version",
              "type": "integer"
            },
            "doc_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Doc Hash",
              "type": "string"
            },
            "slice_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Slice Hash",
              "type": "string"
            }
          },
          "required": [
            "version",
            "doc_hash",
            "slice_hash"
          ],
          "title": "CompanyParameterConfigPin",
          "type": "object"
        },
        "CompanyParameterReference": {
          "additionalProperties": false,
          "properties": {
            "profile_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "title": "Profile Id",
              "type": "string"
            },
            "profile_hash": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Profile Hash",
              "type": "string"
            },
            "client_config": {
              "$ref": "#/$defs/CompanyParameterConfigPin"
            }
          },
          "required": [
            "profile_id",
            "profile_hash",
            "client_config"
          ],
          "title": "CompanyParameterReference",
          "type": "object"
        },
        "ExternalEnvironment": {
          "enum": [
            1,
            2
          ],
          "title": "ExternalEnvironment",
          "type": "integer"
        },
        "TableOperation": {
          "enum": [
            "inclusao",
            "alteracao"
          ],
          "title": "TableOperation",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "request_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Request Ref",
          "type": "string"
        },
        "establishment_cnpj": {
          "title": "Establishment Cnpj",
          "type": "string"
        },
        "expected_mode_revision": {
          "minimum": 1,
          "title": "Expected Mode Revision",
          "type": "integer"
        },
        "environment": {
          "$ref": "#/$defs/ExternalEnvironment"
        },
        "operation": {
          "$ref": "#/$defs/TableOperation"
        },
        "validity_start": {
          "title": "Validity Start",
          "type": "string"
        },
        "validity_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validity End"
        },
        "profile_pin": {
          "$ref": "#/$defs/CompanyParameterReference"
        }
      },
      "required": [
        "request_ref",
        "establishment_cnpj",
        "expected_mode_revision",
        "environment",
        "operation",
        "validity_start",
        "profile_pin"
      ],
      "title": "CandidatePreparation",
      "type": "object"
    },
    "cancellation_schema": {
      "additionalProperties": false,
      "properties": {
        "request_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Request Ref",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "request_ref",
        "expected_revision",
        "reason"
      ],
      "title": "CandidateCancellation",
      "type": "object"
    },
    "operations": [
      "get_company_esocial_candidate_contract",
      "prepare_company_esocial_candidate",
      "get_company_esocial_candidate",
      "cancel_company_esocial_candidate"
    ],
    "supported_event_types": [
      "S-1005"
    ],
    "states": [
      "PREPARED_UNSIGNED",
      "CANCELLED"
    ],
    "unsigned_only": true,
    "preparation_only": true,
    "signing_supported": false,
    "sending_supported": false,
    "allowed_multiple_preparations": true,
    "execution_deduplication_verified": false,
    "production_activation_supported": false,
    "history_import_creates_outbound_events": false,
    "host_generates_event_id": true,
    "full_event_xsd_validation_requires_signature": true,
    "original_antecedents_or_inclusion_are_not_inferred": true,
    "fiscal_authorization_verified": false,
    "transmission_ready": false,
    "pending": [
      "unsigned_event_not_signed",
      "full_event_xsd_validation_pending_signature",
      "fiscal_authorization_not_implemented",
      "fiscal_dispatcher_not_configured",
      "signing_provider_not_configured",
      "company_representation_not_verified",
      "homologation_receipt_not_verified"
    ]
  },
  "limits": [
    "mode_configuration_is_not_transmission",
    "document_approval_does_not_authorize_fiscal_events",
    "signing_and_dispatcher_provisioning_not_implemented"
  ]
}
